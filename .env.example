# ── Telegram Bot ──────────────────────────────────────
# 1. Відкрийте Telegram → @BotFather → /newbot
# 2. Отримайте токен та вставте нижче
BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Отримайте ваш Chat ID:
#    Напишіть /start своєму боту, потім відкрийте:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    Знайдіть "chat":{"id": XXXXXXXXX} — це і є ваш Chat ID
ADMIN_CHAT_ID=123456789

# ── Server ────────────────────────────────────────────
CHAT_PORT=3001
SITE_PORT=3000
